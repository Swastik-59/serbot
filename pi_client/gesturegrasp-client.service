# Starts the GestureGrasp camera client when the Raspberry Pi boots, and restarts it if it stops.
# Install (see GUIDE.md, step 3.5):
#   1. Edit User, WorkingDirectory, ExecStart and the laptop IP below.
#   2. sudo cp gesturegrasp-client.service /etc/systemd/system/
#   3. sudo systemctl daemon-reload && sudo systemctl enable --now gesturegrasp-client
#   Logs: journalctl -u gesturegrasp-client -f

[Unit]
Description=GestureGrasp camera client (streams to the laptop server)
Wants=network-online.target
After=network-online.target

[Service]
User=pi
WorkingDirectory=/home/pi/pi_client
ExecStart=/home/pi/pi_client/venv/bin/python client.py --server ws://192.168.1.21:8000/ws/stream --speak
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
